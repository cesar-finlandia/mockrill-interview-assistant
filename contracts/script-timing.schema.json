{
  "$id": "https://chassis/contracts/script-timing.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScriptTiming",
  "description": "Timing config for pitch script — validated by src/ideation/script/timing.ts (SCRIPT-01)",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "total_minutes", "sections"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "total_minutes": {
      "type": ["number", "null"],
      "description": "Total duration in minutes, must equal sum(sections[].minutes)"
    },
    "total": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]{2}$",
      "description": "Human display total mm:ss or h:mm — handout A4 alias for total_minutes*60"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered script sections — adding a section is config-only (SCRIPT-REU-02)",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title", "minutes"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "minutes": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10
          },
          "live": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "duration": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}$"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
